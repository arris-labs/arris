{
  "permissions": {
    "allow": [
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(cargo test*)",
      "Bash(cargo run*)",
      "Bash(cargo fmt*)",
      "Bash(cargo clippy*)",
      "Bash(cargo doc*)",
      "Bash(cargo tree*)",
      "Bash(cargo metadata*)",
      "Bash(cargo add*)",
      "Bash(cargo remove*)",
      "Bash(cargo update*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(cargo bench*)",
      "Bash(uv run*)",
      "Bash(uv sync*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/bash-guard.sh"
          }
        ]
      }
    ]
  }
}
