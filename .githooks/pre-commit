#!/usr/bin/env bash
# main is always green: fmt, clippy -D warnings, tests, rustdoc — before every
# commit. Shared by every agent and the human via
# `git config core.hooksPath .githooks` (AGENTS.md, "Setup").
#
# The gate is sized to what the commit stages, so a commit that cannot change
# what the suite tests does not pay for the suite:
# - prose only (`*.md`, `.agents/`): the tests that read docs — the plan
#   citations and the roadmap's histogram (`docs_refs`), the invariants
#   table (`doc_drift`);
# - a version bump only (`Cargo.toml`, `Cargo.lock`, every changed line a
#   `version` set to the workspace's new version): `cargo check`, which
#   fails on a pin the bump missed;
# - anything else (ADR-0078): the static half here (layers, new tolerance
#   literals, fmt, clippy), then HEAD's verification state. `pass`: the test
#   half is deferred to the post-commit hook, which runs it in the background
#   on the commit's own tree (`tools/verify.sh`). Otherwise (a red, or none)
#   the test half runs here over everything since the last verified commit.
#   A verification still running is waited for. `ARRIS_VERIFY=inline` never
#   defers. The test half, `tools/test-half.sh`, is sized by `tools/gate.sh`
#   (ADR-0032): the doctests always; the
#   `fast` nextest profile (`.config/nextest.toml`: no `real_*`, no slow
#   singles) at 16 cases over
#   the crates the paths reach and the corpus areas they can change; `cargo
#   doc` only when a doc comment changed. A path the classifier cannot place
#   runs the whole `fast` profile. Depth is the plan's retirement, CI and
#   nightly: 256 cases, every test, `real_*`, the docs build.
# - `ARRIS_GATE=full`: the old gate, every test at 256 cases and `cargo doc`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
[ -f Cargo.toml ] || exit 0
# The gate runs in its own memory-bounded scope (`tools/gate-scope.sh`), so
# memory pressure ends the gate and not the terminal's scope. Re-run once
# through it; unchanged where `systemd-run --user` is absent or
# `ARRIS_GATE_SCOPE=off`.
[ -n "${ARRIS_GATE_SCOPED:-}" ] || ARRIS_GATE_SCOPED=1 exec tools/gate-scope.sh "$0" "$@"
# ARRIS_STATIC_CMD, ARRIS_DOCS_CMD and ARRIS_TEST_HALF_CMD replace the halves
# in `tools/hook-flow-test.sh`; unset in real use.
[ -n "${ARRIS_STATIC_CMD:-}" ] || command -v cargo-nextest >/dev/null || {
  echo "pre-commit: cargo-nextest is missing. Run:" >&2
  echo "    cargo install cargo-nextest --locked" >&2
  echo "(AGENTS.md, \"Setup\"). The suite runs under nextest so that the 53" >&2
  echo "test binaries overlap instead of running one after another." >&2
  exit 1
}

# Half the machine's cores, unless the caller set its own: the other half
# is another project's (the profile's `test-threads` says the same for
# nextest; these reach cargo's build and rayon inside the tests).
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-16}
export NEXTEST_TEST_THREADS=${NEXTEST_TEST_THREADS:-16}
export RAYON_NUM_THREADS=${RAYON_NUM_THREADS:-16}

staged=$(git diff --cached --name-only --diff-filter=ACMRD)
[ -n "$staged" ] || exit 0

# What the post-commit hook does with this commit (`pass`, `deferred` or
# `inherit`, ADR-0078); an early exit leaves it unset and the commit verified.
state_dir=$(realpath "$(git rev-parse --git-common-dir)")/arris-verify
mkdir -p "$state_dir"
rm -f "$state_dir/next"

# One gate at a time per checkout. A second one, often left by a session
# that ran out of context, shares `target/` and the machine's memory and
# finishes neither sooner; it fails at once naming the first. The lock is
# held by every process the gate starts, so it frees when the last exits.
if command -v flock >/dev/null; then
  lock=$(git rev-parse --git-path arris-gate.lock)
  exec 9>>"$lock"
  if ! flock -n 9; then
    holder=$(cat "$lock" 2>/dev/null || true)
    echo "pre-commit: a gate is already running here (pid ${holder:-?})." >&2
    echo "Wait for it with \`flock $lock true\`, or stop it with tools/stop-gate.sh." >&2
    exit 1
  fi
  echo $$ >"$lock"
fi

# Every staged path is prose.
prose_only() {
  ! grep -qvE '(\.md$|^\.agents/)' <<<"$staged"
}

# Every staged path is a manifest, and every changed line in it sets a
# version to the workspace's new one.
version_bump_only() {
  ! grep -qvxE 'Cargo\.(toml|lock)' <<<"$staged" || return 1
  local version changed
  version=$(git show :Cargo.toml | sed -n 's/^version = "\(.*\)"$/\1/p' | head -1)
  [ -n "$version" ] || return 1
  changed=$(git diff --cached -U0 -- Cargo.toml Cargo.lock | grep -E '^[+-][^+-]' || true)
  [ -n "$changed" ] || return 1
  # Removed lines set some version; added lines set exactly the new one.
  ! grep -E '^-' <<<"$changed" | grep -qvE '\bversion = "=?[^"]*"' &&
    ! grep -E '^\+' <<<"$changed" | grep -qvE "\bversion = \"=?${version//./\\.}\""
}

if prose_only; then
  echo "pre-commit: prose only — the docs tests"
  if [ -n "${ARRIS_DOCS_CMD:-}" ]; then
    $ARRIS_DOCS_CMD
  else
    cargo nextest run -p arris --test docs_refs -p arris-check --test doc_drift \
      --cargo-quiet --status-level fail
  fi
  echo inherit >"$state_dir/next"
  exit 0
fi

if version_bump_only; then
  echo "pre-commit: a version bump only — cargo check"
  cargo check --workspace --all-targets --quiet
  echo inherit >"$state_dir/next"
  exit 0
fi

# Stage times, printed as one line at the end of a code commit: `stage NAME`
# records the seconds since the previous mark.
t_last=$EPOCHREALTIME
times=""
stage() {
  local now=$EPOCHREALTIME
  times+="$1=$(awk -v a="$t_last" -v b="$now" 'BEGIN { printf "%.1f", b - a }') "
  t_last=$now
}

static_half() {
  echo "pre-commit: layer rule" && tools/check-layers.sh
  echo "pre-commit: tolerance literals" && tools/check-tolerance-literals.sh
  echo "pre-commit: cargo fmt --check" && cargo fmt --all -- --check
  echo "pre-commit: cargo clippy" && cargo clippy --workspace --all-targets -- -D warnings
  # The classifier's own test, whenever the classifier or the profiles change.
  if grep -qE '^(tools/gate|\.config/)' <<<"$staged"; then
    echo "pre-commit: the gate's classifier" && tools/gate-test.sh && tools/profile-test.sh
    grep -q '^tools/gate-scope' <<<"$staged" && tools/gate-scope-test.sh
  fi
  if grep -qE '^(\.githooks/|tools/(verify|hook-flow))' <<<"$staged"; then
    echo "pre-commit: the hooks' flow" && tools/verify-test.sh && tools/hook-flow-test.sh
  fi
  return 0
}
if [ -n "${ARRIS_STATIC_CMD:-}" ]; then $ARRIS_STATIC_CMD; else static_half; fi
stage static

if [ "${ARRIS_GATE:-}" = full ]; then
  echo "pre-commit: ARRIS_GATE=full — every test"
  echo "pre-commit: cargo nextest" && cargo nextest run --workspace --cargo-quiet --status-level fail
  echo "pre-commit: cargo test --doc" && cargo test --workspace --doc --quiet
  echo "pre-commit: cargo doc" && RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --quiet
  echo pass >"$state_dir/next"
  exit 0
fi

empty=$(git hash-object -t tree /dev/null)
head=$(git rev-parse --verify -q HEAD || true)
head_state=none
[ -z "$head" ] || head_state=$(tools/verify.sh --status "$head") # waits on a running one
if [ "$head_state" = pass ]; then
  base=$head
else
  # The last verified commit on this line; the whole profile when none is
  # within reach.
  base=$empty
  if [ -n "$head" ]; then
    for c in $(git rev-list --first-parent --max-count=200 "$head"); do
      if [ "$(cat "$state_dir/$c" 2>/dev/null)" = pass ]; then base=$c; break; fi
    done
  fi
fi

if [ "$head_state" = pass ] && [ "${ARRIS_VERIFY:-}" != inline ]; then
  echo "pre-commit: test half deferred to the verification of this commit"
  echo deferred >"$state_dir/next"
else
  [ "$head_state" = pass ] || echo "pre-commit: ${head:-no commit} is not verified ($head_state): test half over everything since ${base:0:8}"
  if [ -n "${ARRIS_TEST_HALF_CMD:-}" ]; then $ARRIS_TEST_HALF_CMD "$base"; else tools/test-half.sh "$base"; fi
  echo pass >"$state_dir/next"
fi
stage test
echo "pre-commit: stage seconds: $times"
