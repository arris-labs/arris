#!/usr/bin/env python3
"""Digest this repository's Claude Code session transcripts for /retro.

Usage: .agents/skills/retro/session-digest [--slug SLUG] [--last N] [--session ID]...

Finds the transcripts of the checkout it lives in (under every
~/.claude*/projects, or $CLAUDE_CONFIG_DIR/projects), picks the sessions
that mention SLUG (a plan slug), the N most recent, or the given ids, and
prints for each: when and how long, the models, the human's own messages,
the skills and tools used, the tool calls that failed, and the longest
stalls between entries. The transcripts are read only.
"""

import argparse
import glob
import json
import os
import re
import sys
from datetime import datetime

def repo_root(here):
    while not os.path.exists(os.path.join(here, ".git")) and os.path.dirname(here) != here:
        here = os.path.dirname(here)
    return here


ROOT = repo_root(os.path.dirname(os.path.realpath(__file__)))


def project_dirs():
    name = ROOT.replace("/", "-").replace(".", "-")
    bases = []
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        bases.append(os.environ["CLAUDE_CONFIG_DIR"])
    bases += glob.glob(os.path.expanduser("~/.claude*"))
    return [d for b in bases for d in [os.path.join(b, "projects", name)] if os.path.isdir(d)]


def started(path):
    for line in open(path, encoding="utf-8", errors="replace"):
        m = re.search(r'"timestamp":\s*"([^"]+)"', line)
        if m:
            return m.group(1)
    return ""


def when(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")) if ts else None


def text_of(content):
    if isinstance(content, str):
        return content
    return " ".join(c.get("text", "") for c in content if c.get("type") == "text")


def human(t):
    t = t.strip()
    if not t or "<task-notification>" in t or t.startswith("<local-command"):
        return None
    if "<command-name>" in t:
        name = t.split("<command-name>")[1].split("</command-name>")[0]
        args = t.split("<command-args>")[1].split("</command-args>")[0] if "<command-args>" in t else ""
        return None if name in ("/clear", "/model") and not args else f"{name} {args}".strip()
    return t


def digest(path, width):
    tools, skills, failures, said, models = {}, {}, [], [], {}
    pending, stamps = {}, []
    for line in open(path, encoding="utf-8", errors="replace"):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        if o.get("isSidechain"):
            continue
        if o.get("timestamp"):
            stamps.append(when(o["timestamp"]))
        msg = o.get("message") or {}
        if o.get("type") == "assistant":
            models[msg.get("model")] = models.get(msg.get("model"), 0) + 1
            for c in msg.get("content", []):
                if c.get("type") == "tool_use":
                    name = c["name"]
                    tools[name] = tools.get(name, 0) + 1
                    if name == "Skill":
                        s = c["input"].get("skill", "")
                        skills[s] = skills.get(s, 0) + 1
                    pending[c["id"]] = (name, json.dumps(c["input"])[:width])
        elif o.get("type") == "user" and not o.get("isMeta"):
            content = msg.get("content")
            if isinstance(content, list):
                for c in content:
                    if c.get("type") == "tool_result" and c.get("is_error"):
                        name, inp = pending.get(c.get("tool_use_id"), ("?", ""))
                        out = text_of(c["content"]) if isinstance(c.get("content"), list) else str(c.get("content"))
                        failures.append(f"{name} {inp} -> {out.strip()[:width]}")
            t = human(text_of(content or ""))
            if t:
                said.append(t.replace("\n", " / ")[: width * 2])
    stamps = [s for s in stamps if s]
    gaps = sorted(((b - a).total_seconds(), a) for a, b in zip(stamps, stamps[1:]))[-3:]
    sid = os.path.basename(path)[:8]
    if stamps:
        span = (stamps[-1] - stamps[0]).total_seconds() / 60
        print(f"## {sid}  {stamps[0]:%Y-%m-%d %H:%M} UTC, {span:.0f} min, {os.path.getsize(path) // 1024} KB")
    print("models:", ", ".join(f"{m} {n}" for m, n in models.items() if m))
    print("skills:", ", ".join(f"{s} {n}" for s, n in skills.items()) or "none")
    print("tools:", ", ".join(f"{t} {n}" for t, n in sorted(tools.items(), key=lambda x: -x[1])))
    print("longest stalls:", ", ".join(f"{g / 60:.0f} min at {a:%H:%M}" for g, a in reversed(gaps) if g > 120) or "none")
    print("the human said:")
    for t in said:
        print("  >", t)
    print(f"failed tool calls ({len(failures)}):")
    for f in failures[:15]:
        print("  !", f)
    print()


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--slug", help="sessions mentioning this plan slug")
    ap.add_argument("--last", type=int, help="the N most recent sessions")
    ap.add_argument("--session", action="append", default=[], help="a session id (prefix)")
    ap.add_argument("--width", type=int, default=200, help="characters kept per item")
    ap.add_argument("--project-dir", action="append", default=[],
                    help="another transcript directory (the checkout's old path, after a move)")
    a = ap.parse_args()
    dirs = project_dirs() + a.project_dir
    unique = {}  # a session copied under two config dirs is one session
    for f in (f for d in dirs for f in glob.glob(os.path.join(d, "*.jsonl"))):
        unique.setdefault(os.path.basename(f), f)
    files = sorted((f for f in unique.values() if started(f)), key=started)  # an empty one has no time
    if not files:
        sys.exit(f"no transcripts for {ROOT}")
    picked = [f for f in files if any(os.path.basename(f).startswith(s) for s in a.session)]
    if a.slug:
        picked += [f for f in files if a.slug in open(f, encoding="utf-8", errors="replace").read()]
    if a.last:
        picked += files[-a.last:]
    if not (a.slug or a.last or a.session):
        picked = files[-1:]
    for f in sorted(set(picked), key=started):
        digest(f, a.width)


if __name__ == "__main__":
    main()
