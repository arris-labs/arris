#!/usr/bin/env python3
"""Digest this repository's Claude Code and Codex session transcripts for /retro.

Usage: .agents/skills/retro/session-digest [--slug SLUG] [--last N] [--session ID]...

Finds the checkout's Claude Code transcripts under ~/.claude*/projects
(or $CLAUDE_CONFIG_DIR/projects) and Codex rollouts under $CODEX_HOME
(default ~/.codex). Select by plan slug, recent session or ID prefix.
Reports Claude tool errors and stalls, and Codex usage, waits and largest
tool results, including child rollouts linked to selected Codex sessions.
Transcripts are read only.
"""

import argparse
import glob
import json
import os
import re
import sys
from collections import Counter
from datetime import datetime

def repo_root(here):
    while not os.path.exists(os.path.join(here, ".git")) and os.path.dirname(here) != here:
        here = os.path.dirname(here)
    return here


ROOT = repo_root(os.path.dirname(os.path.realpath(__file__)))


def project_dirs():
    name = ROOT.replace("/", "-").replace(".", "-")
    bases = []
    if os.environ.get("CLAUDE_CONFIG_DIR"):
        bases.append(os.environ["CLAUDE_CONFIG_DIR"])
    bases += glob.glob(os.path.expanduser("~/.claude*"))
    return [d for b in bases for d in [os.path.join(b, "projects", name)] if os.path.isdir(d)]


def started(path):
    for line in open(path, encoding="utf-8", errors="replace"):
        m = re.search(r'"timestamp":\s*"([^"]+)"', line)
        if m:
            return m.group(1)
    return ""


def when(ts):
    return datetime.fromisoformat(ts.replace("Z", "+00:00")) if ts else None


def text_of(content):
    if isinstance(content, str):
        return content
    return " ".join(c.get("text", "") for c in content if c.get("type") == "text")


def human(t):
    t = t.strip()
    if not t or "<task-notification>" in t or t.startswith("<local-command"):
        return None
    if "<command-name>" in t:
        name = t.split("<command-name>")[1].split("</command-name>")[0]
        args = t.split("<command-args>")[1].split("</command-args>")[0] if "<command-args>" in t else ""
        return None if name in ("/clear", "/model") and not args else f"{name} {args}".strip()
    return t


def subagent_failures(path, width):
    """Failed tool calls of the subagents a session started (<id>/subagents/)."""
    out = []
    for f in sorted(glob.glob(os.path.join(path[: -len(".jsonl")], "subagents", "*.jsonl"))):
        pending = {}
        for line in open(f, encoding="utf-8", errors="replace"):
            try:
                o = json.loads(line)
            except ValueError:
                continue
            content = (o.get("message") or {}).get("content")
            if not isinstance(content, list):
                continue
            for c in content:
                if c.get("type") == "tool_use":
                    pending[c["id"]] = (c["name"], json.dumps(c["input"])[:width])
                elif c.get("type") == "tool_result" and c.get("is_error"):
                    name, inp = pending.get(c.get("tool_use_id"), ("?", ""))
                    res = text_of(c["content"]) if isinstance(c.get("content"), list) else str(c.get("content"))
                    out.append(f"[{os.path.basename(f)[6:14]}] {name} {inp} -> {res.strip()[:width]}")
    return out


def digest(path, width):
    tools, skills, failures, said, models = {}, {}, [], [], {}
    pending, stamps = {}, []
    for line in open(path, encoding="utf-8", errors="replace"):
        try:
            o = json.loads(line)
        except ValueError:
            continue
        att = o.get("attachment") or {}
        if att.get("type") == "queued_command" and (att.get("origin") or {}).get("kind") == "human":
            said.append("(sent mid-turn) " + str(att.get("prompt", "")).replace("\n", " / ")[: width * 2])
        if o.get("isSidechain"):
            continue
        if o.get("timestamp"):
            stamps.append(when(o["timestamp"]))
        msg = o.get("message") or {}
        if o.get("type") == "assistant":
            models[msg.get("model")] = models.get(msg.get("model"), 0) + 1
            for c in msg.get("content", []):
                if c.get("type") == "tool_use":
                    name = c["name"]
                    tools[name] = tools.get(name, 0) + 1
                    if name == "Skill":
                        s = c["input"].get("skill", "")
                        skills[s] = skills.get(s, 0) + 1
                    pending[c["id"]] = (name, json.dumps(c["input"])[:width])
        elif o.get("type") == "user" and not o.get("isMeta"):
            content = msg.get("content")
            if isinstance(content, list):
                for c in content:
                    if c.get("type") == "tool_result" and c.get("is_error"):
                        name, inp = pending.get(c.get("tool_use_id"), ("?", ""))
                        out = text_of(c["content"]) if isinstance(c.get("content"), list) else str(c.get("content"))
                        failures.append(f"{name} {inp} -> {out.strip()[:width]}")
            t = human(text_of(content or ""))
            if t:
                said.append(t.replace("\n", " / ")[: width * 2])
    stamps = [s for s in stamps if s]
    gaps = sorted(((b - a).total_seconds(), a) for a, b in zip(stamps, stamps[1:]))[-3:]
    sid = os.path.basename(path)[:8]
    if stamps:
        span = (stamps[-1] - stamps[0]).total_seconds() / 60
        print(f"## {sid}  {stamps[0]:%Y-%m-%d %H:%M} UTC, {span:.0f} min, {os.path.getsize(path) // 1024} KB")
    print("models:", ", ".join(f"{m} {n}" for m, n in models.items() if m))
    print("skills:", ", ".join(f"{s} {n}" for s, n in skills.items()) or "none")
    print("tools:", ", ".join(f"{t} {n}" for t, n in sorted(tools.items(), key=lambda x: -x[1])))
    print("longest stalls:", ", ".join(f"{g / 60:.0f} min at {a:%H:%M}" for g, a in reversed(gaps) if g > 120) or "none")
    print("the human said:")
    for t in said:
        print("  >", t)
    print(f"failed tool calls ({len(failures)}):")
    for f in failures[:15]:
        print("  !", f)
    sub = subagent_failures(path, width)
    print(f"failed tool calls of subagents ({len(sub)}):")
    for f in sub[:15]:
        print("  !", f)
    print()


def records(path):
    with open(path, encoding="utf-8", errors="replace") as stream:
        for line in stream:
            try:
                yield json.loads(line)
            except ValueError:
                continue


def mentions(path, slug):
    with open(path, encoding="utf-8", errors="replace") as stream:
        return any(slug in line for line in stream)


def codex_sessions():
    home = os.environ.get("CODEX_HOME", os.path.expanduser("~/.codex"))
    sessions = {}
    for directory in ("sessions", "archived_sessions"):
        for path in glob.iglob(os.path.join(home, directory, "**", "rollout-*.jsonl"), recursive=True):
            first = next(records(path), {})
            if first.get("type") != "session_meta":
                continue
            meta = first["payload"]
            source = meta.get("source")
            spawn = source.get("subagent", {}).get("thread_spawn", {}) if isinstance(source, dict) else {}
            sessions[meta["id"]] = (path, meta, spawn)
    return sessions


def codex_digest(path, meta, spawn, width):
    counts, waits, models = Counter(), Counter(), set()
    calls, largest, failed, human_messages, gaps = {}, [], [], [], []
    phase, baseline, totals = "session", Counter(), Counter()
    retirement_tasks = {"retirement_review", "retirement", "retirement_coordinator"}
    phases = {}
    start = previous = end = None
    for row in records(path):
        stamp = when(row.get("timestamp"))
        if stamp:
            start = start or stamp
            if previous and (stamp - previous).total_seconds() > 120:
                gaps.append(((stamp - previous).total_seconds(), previous))
            previous = end = stamp
        payload = row.get("payload", {})
        kind = payload.get("type")
        if row.get("type") == "turn_context" and payload.get("model"):
            models.add(payload["model"])
        if row.get("type") == "event_msg" and kind == "user_message":
            human_messages.append(payload.get("message", ""))
        if kind in ("function_call", "custom_tool_call"):
            name = payload.get("name", "?")
            arg = payload.get("arguments", payload.get("input", ""))
            counts[name] += 1
            if name in ("wait_agent", "sleep", "wait", "write_stdin"):
                waits[name] += 1
            if name == "spawn_agent" and phase == "session":
                try:
                    task = json.loads(arg).get("task_name", "")
                except (ValueError, AttributeError):
                    task = ""
                if task in retirement_tasks:
                    if totals:
                        phases["before retirement agent launch"] = phases.pop("session", totals)
                    phase, baseline = "from retirement agent launch", totals.copy()
            calls[payload["call_id"]] = (name, str(arg).splitlines()[0][:width] if arg else "")
        if kind in ("function_call_output", "custom_tool_call_output"):
            name, brief = calls.pop(payload["call_id"], ("?", ""))
            output = str(payload.get("output", ""))
            if stamp:
                largest.append((len(output.encode("utf-8")), stamp, name, brief))
            if stamp and re.search(
                    r"(?:Process exited with code [1-9]|exit_code[^0-9-]+-?[1-9])",
                    output[:1200]):
                failed.append((stamp, name, brief))
        if kind == "token_count" and payload.get("info"):
            totals = Counter(payload["info"]["total_token_usage"])
            phases[phase] = totals - baseline
    role = spawn.get("agent_path") or "top-level"
    parent = spawn.get("parent_thread_id", "")
    print(f"## {meta['id'][:13]} Codex {role}" + (f" (parent {parent[:8]})" if parent else ""))
    if start and end:
        print(f"started {start:%Y-%m-%d %H:%M UTC}, {(end-start).total_seconds()/60:.1f} min")
    print("models:", ", ".join(sorted(models)) or "unavailable")
    for label, usage in phases.items():
        cached = usage["cached_input_tokens"]
        uncached = usage["input_tokens"] - cached
        print(f"{label} tokens: {cached:,} cached input, {uncached:,} uncached input, "
              f"{usage['output_tokens']:,} output")
    print("tools:", ", ".join(f"{name} {count}" for name, count in counts.most_common()) or "none")
    print("wait calls:", ", ".join(f"{name} {count}" for name, count in waits.most_common()) or "none")
    print("longest stalls:", ", ".join(f"{gap/60:.0f} min at {stamp:%H:%M}"
                                      for gap, stamp in sorted(gaps, reverse=True)[:3]) or "none")
    print("the human said:")
    for message in human_messages:
        print("  >", message.replace("\n", " / ")[:width * 2])
    print(f"failed tool calls ({len(failed)}):")
    for stamp, name, brief in failed[:15]:
        print(f"  ! {stamp:%H:%M:%S} {name} {brief}")
    print("largest tool results (serialized bytes):")
    for size, stamp, name, brief in sorted(largest, key=lambda item: item[0], reverse=True)[:5]:
        print(f"  {size:,} {stamp:%H:%M:%S} {name} {brief}")
    print()


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--slug", help="sessions mentioning this plan slug")
    ap.add_argument("--last", type=int, help="the N most recent sessions")
    ap.add_argument("--session", action="append", default=[], help="a session id (prefix)")
    ap.add_argument("--width", type=int, default=200, help="characters kept per item")
    ap.add_argument("--project-dir", action="append", default=[],
                    help="another transcript directory (the checkout's old path, after a move)")
    a = ap.parse_args()
    dirs = project_dirs() + a.project_dir
    unique = {}  # a session copied under two config dirs is one session
    for f in (f for d in dirs for f in glob.glob(os.path.join(d, "*.jsonl"))):
        unique.setdefault(os.path.basename(f), f)
    files = sorted((f for f in unique.values() if started(f)), key=started)  # an empty one has no time
    codex = codex_sessions()
    scoped = {sid for sid, (_, meta, _) in codex.items()
              if os.path.realpath(meta.get("cwd", "")) == ROOT}
    explicit = {sid for sid in codex if any(sid.startswith(prefix) for prefix in a.session)}
    options = {f: (started(f), None) for f in files}
    options.update({codex[sid][0]: (started(codex[sid][0]), sid) for sid in scoped | explicit})
    if not options:
        sys.exit(f"no transcripts for {ROOT}")
    picked = {f for f in files if any(os.path.basename(f).startswith(prefix) for prefix in a.session)}
    picked.update(codex[sid][0] for sid in explicit)
    if a.slug:
        picked.update(f for f in options if mentions(f, a.slug))
    ordered = sorted(options, key=lambda f: options[f][0])
    if a.last:
        picked.update(ordered[-a.last:])
    if not (a.slug or a.last or a.session):
        picked.add(ordered[-1])
    selected = {options[f][1] for f in picked if options[f][1]}
    while True:
        children = {sid for sid, (_, _, spawn) in codex.items()
                    if spawn.get("parent_thread_id") in selected}
        if children <= selected:
            break
        selected.update(children)
    entries = [(options[f][0], f, None) for f in picked if options[f][1] is None]
    entries += [(started(codex[sid][0]), codex[sid][0], sid) for sid in selected]
    for _, path, sid in sorted(entries):
        if sid:
            codex_digest(*codex[sid], a.width)
        else:
            digest(path, a.width)


if __name__ == "__main__":
    main()
