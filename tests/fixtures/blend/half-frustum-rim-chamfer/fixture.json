              2,
              0
            ]
          },
          {
            "line_to": [
              1,
              1
            ]
          },
          {
            "line_to": [
              0,
              1
            ]
          },
          {
            "line_to": [
              0,
              0
            ]
          }
        ]
      }
    },
    {
      "name": "part",
      "op": "revolve",
      "profile": "section",
      "axis": {
        "origin": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          1
        ]
      },
