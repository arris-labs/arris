{
  "description": "blend/tangent-chain-horn-torus with a box cut through its horn blend: the box [1.9, -1, 1.95]-[3, 0.1, 3] has planes x = 1.9, y = 0.1 and z = 1.95 off the torus's axis (x = 1.8, y = 0.2), each cutting the horn face (a plane through the axis stays refused). The result is an operand of a boolean, as the ring torus's faces are (ADR-0080)",
  "params": {"r": 0.2, "r2": 0.1},
  "steps": [
    {
      "name": "square",
      "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 1, 0]},
      "outer": {"start": [0, 0], "segments": [{"line_to": [2, 0]}, {"line_to": [2, 2]}, {"line_to": [0, 2]}, {"line_to": [0, 0]}]}
    },
    {"name": "cube", "op": "extrude", "profile": "square", "direction": [0, 0, 1], "length": 2},
    {"name": "first", "op": "fillet", "of": "cube", "edges": [[2, 0, 1]], "radius": "r"},
    {"name": "blended", "op": "fillet", "of": "first", "edges": [[1, 0, 2]], "radius": "r2"},
    {"name": "tool", "op": "box", "min": [1.9, -1, 1.95], "max": [3, 0.1, 3]},
    {"name": "result", "op": "cut", "target": "blended", "tool": "tool"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [1, 1, 1], "expect": "in"},
    {"label": "in the cut", "point": [2.0, 0.0, 2.0], "expect": "out"}
  ],
  "analytic": {
    "genus": 0
  }
}
