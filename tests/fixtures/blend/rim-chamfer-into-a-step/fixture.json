{
  "description": "blend/rim-fillet-into-a-step's stepped cylinder, the low quarter's rim chamfered at d 0.3: the blend is a quarter of a cone at 45°, each end a mixed corner whose vertical edge is lengthened down the cylinder to the side leg and whose step takes the chamfer's triangle (ADR-0038). The volume is 7π less the triangle d² / 2 swept a quarter turn at R − d / 3 by Pappus; the area 15π + 4 less the top's quarter annulus and the side's band, plus the cone's quarter, slant d√2 at mean radius R − d / 2, and the two triangles the steps gain",
  "params": {"d": 0.3},
  "steps": [
    {"name": "drum", "op": "cylinder", "base": [0, 0, 0], "axis": [0, 0, 1], "radius": 2, "height": 2},
    {"name": "quarter", "op": "box", "min": [-3, 0, 1], "max": [0, 3, 3]},
    {"name": "stepped", "op": "cut", "target": "drum", "tool": "quarter"},
    {"name": "result", "op": "chamfer", "of": "stepped", "edges": [["-sqrt(2)", "sqrt(2)", 1]], "distance": "d"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [-1, 1, 0.5], "expect": "in"},
    {"label": "tall_inside", "point": [1, 1, 1.5], "expect": "in"},
    {"label": "above_low", "point": [-1, 1, 1.5], "expect": "out"},
    {"label": "corner_gone", "point": ["-1.98 / sqrt(2)", "1.98 / sqrt(2)", 0.98], "expect": "out"},
    {"label": "on_chamfer", "point": ["-(2 - d / 2) / sqrt(2)", "(2 - d / 2) / sqrt(2)", "1 - d / 2"], "expect": "on"},
    {"label": "on_side_contact", "point": ["-sqrt(2)", "sqrt(2)", "1 - d"], "expect": "on"},
    {"label": "on_top_contact", "point": ["-(2 - d) / sqrt(2)", "(2 - d) / sqrt(2)", 1], "expect": "on"},
    {"label": "on_lengthened_edge", "point": [0, 2, "1 - d / 2"], "expect": "on"},
    {"label": "on_other_lengthened_edge", "point": [-2, 0, "1 - d / 2"], "expect": "on"},
    {"label": "on_spandrel", "point": [0, 1.95, 0.95], "expect": "on"},
    {"label": "behind_spandrel", "point": [0.01, 1.95, 0.95], "expect": "in"},
    {"label": "before_spandrel", "point": [-0.01, 1.95, 0.95], "expect": "out"},
    {"label": "on_other_spandrel", "point": [-1.95, 0, 0.95], "expect": "on"},
    {"label": "on_step", "point": [0, 1, 1.5], "expect": "on"}
  ],
  "analytic": {
    "volume": "7 * pi - pi / 2 * (2 - d / 3) * d^2 / 2",
    "area": "15 * pi + 4 - pi / 4 * (4 * d - d^2) - pi * d + pi / 2 * d * sqrt(2) * (2 - d / 2) + d^2",
    "counts": {"vertices": 10, "edges": 15, "faces": 7, "loops": 7, "shells": 1},
    "genus": 0,
    "counts_differ": "Open CASCADE keeps each consumed corner vertex on its lengthened vertical edge, two edges of one line between the same two faces; Arris lengthens the one edge to the trim (ADR-0038)"
