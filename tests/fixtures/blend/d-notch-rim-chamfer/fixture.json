{
  "description": "the D-notch plate of blend/d-notch-rim-fillet with its rim chamfered at d 0.25: an open half circle between the top plane and the notch's cylinder cut flat to half a cone coaxial with the notch, trimmed at each end by the plane y = 0 through the axis. The removed corner's section d\u00b2 / 2 swept half a turn about the axis at R + d / 3 by Pappus (ADR-0035)",
  "params": {
    "d": 0.25
  },
  "steps": [
    {
      "name": "sketch",
      "op": "profile",
      "plane": {
        "origin": [
          0,
          0,
          0
        ],
        "x": [
          1,
          0,
          0
        ],
        "y": [
          0,
          1,
          0
        ]
      },
      "outer": {
        "start": [
          0,
          0
        ],
        "segments": [
          {
            "line_to": [
              1,
              0
            ]
          },
          {
            "arc_to": [
              3,
              0
            ],
            "via": [
              2,
              1
            ]
          },
          {
            "line_to": [
              4,
              0
            ]
          },
          {
            "line_to": [
              4,
              4
            ]
          },
          {
            "line_to": [
              0,
              4
            ]
          },
          {
            "line_to": [
              0,
              0
            ]
          }
        ]
      }
    },
    {
      "name": "plate",
      "op": "extrude",
      "profile": "sketch",
      "direction": [
        0,
        0,
        1
      ],
      "length": 1
    },
    {
      "name": "result",
      "op": "chamfer",
      "of": "plate",
      "edges": [
        [
          2,
          1,
          1
        ]
      ],
      "distance": "d"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "inside",
      "point": [
        0.5,
        2,
        0.5
      ],
      "expect": "in"
    },
    {
      "label": "in_the_notch",
      "point": [
        2,
        0.5,
        0.5
      ],
      "expect": "out"
    },
    {
      "label": "corner_gone",
      "point": [
        2,
        "1 + d / 4",
        "1 - d / 4"
      ],
      "expect": "out"
    },
    {
      "label": "on_chamfer",
      "point": [
        2,
        "1 + d / 2",
        "1 - d / 2"
      ],
      "expect": "on"
    },
    {
      "label": "on_top_contact",
      "point": [
        2,
        "1 + d",
        1
      ],
      "expect": "on"
    },
    {
      "label": "on_wall_contact",
      "point": [
        2,
        1,
        "1 - d"
      ],
      "expect": "on"
    },
    {
      "label": "on_bottom_rim",
      "point": [
        2,
        1,
        0
      ],
      "expect": "on"
    },
    {
      "label": "on_top",
      "point": [
        0.5,
        2,
        1
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "genus": 0,
    "volume": "16 - pi / 2 - pi * (1 + d / 3) * d^2 / 2"
  }
}
