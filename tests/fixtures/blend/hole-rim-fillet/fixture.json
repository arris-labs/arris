{
  "description": "a 4 × 4 plate 1 thick with a hole of radius R 1 through its middle, the hole's top rim filleted at r 0.25: a plane against a cylinder along a circle, convex, the blend a quarter of a torus coaxial with the hole, major radius R + r and minor r, tangent to the top face and to the hole's wall along circles, with no ends; its u seam lies in the half-plane of the hole's own seam, which is shortened to the contact on the wall. The corner's section (1 − π/4) r² swept about the axis at R + r (10 − 3π) / (12 − 3π) by Pappus",
  "params": {"r": 0.25},
  "steps": [
    {"name": "sketch", "op": "profile", "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 1, 0]},
     "outer": {"start": [0, 0], "segments": [{"line_to": [4, 0]}, {"line_to": [4, 4]}, {"line_to": [0, 4]}, {"line_to": [0, 0]}]},
     "holes": [{"circle": {"center": [2, 2], "radius": 1}}]},
    {"name": "plate", "op": "extrude", "profile": "sketch", "direction": [0, 0, 1], "length": 1},
    {"name": "result", "op": "fillet", "of": "plate", "edges": [[1, 2, 1]], "radius": "r"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [0.5, 0.5, 0.5], "expect": "in"},
    {"label": "in_the_hole", "point": [2, 2, 0.5], "expect": "out"},
    {"label": "corner_gone", "point": ["2 + 1 + r - (r + 0.05) * cos(radians(45))", 2, "1 - r + (r + 0.05) * sin(radians(45))"], "expect": "out"},
    {"label": "on_blend", "point": ["2 + 1 + r - r * cos(radians(45))", 2, "1 - r + r * sin(radians(45))"], "expect": "on"},
    {"label": "on_blend_behind", "point": [2, "2 - (1 + r - r * cos(radians(45)))", "1 - r + r * sin(radians(45))"], "expect": "on"},
    {"label": "on_top_contact", "point": [2, "2 + 1 + r", 1], "expect": "on"},
    {"label": "on_wall_contact", "point": [1, 2, "1 - r"], "expect": "on"},
    {"label": "on_bottom_rim", "point": [3, 2, 0], "expect": "on"},
    {"label": "on_top", "point": [0.5, 0.5, 1], "expect": "on"}
  ],
  "analytic": {
    "volume": "16 - pi - 2 * pi * (1 + r * (10 - 3 * pi) / (12 - 3 * pi)) * (1 - pi / 4) * r^2",
    "area": "2 * (16 - pi) - pi * ((1 + r)^2 - 1) + 16 + 2 * pi * (1 - r) + pi^2 * r * (1 + r) - 2 * pi * r^2",
    "counts": {"vertices": 11, "edges": 17, "faces": 8, "loops": 10, "shells": 1},
    "genus": 1
  }
}
