{
  "description": "a plate [0,0,0]\u2013[20,10,2] with a rib [5,4,2]\u2013[15,6,8] standing on it, the rib's vertical corner edge at (5, 4) filleted at r 0.5: a convex blend whose lower end meets the plate's top, a face that surrounds the rib, so the edge's corner with it is concave and the end arc lies in the rib's footprint, a hole of the plate's top, which the blend gives back to the plate (NIST 827-9999-906, the ribs' sloped corners)",
  "params": {
    "r": 0.5
  },
  "steps": [
    {
      "name": "plate",
      "op": "box",
      "min": [
        0,
        0,
        0
      ],
      "max": [
        20,
        10,
        2
      ]
    },
    {
      "name": "rib",
      "op": "box",
      "min": [
        5,
        4,
        2
      ],
      "max": [
        15,
        6,
        8
      ]
    },
    {
      "name": "ribbed",
      "op": "fuse",
      "a": "plate",
      "b": "rib"
    },
    {
      "name": "result",
      "op": "fillet",
      "of": "ribbed",
      "edges": [
        [
          5,
          4,
          5
        ]
      ],
      "radius": "r"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "inside_rib",
      "point": [
        10,
        5,
        5
      ],
      "expect": "in"
    },
    {
      "label": "removed_corner",
      "point": [
        5.02,
        4.02,
        5
      ],
      "expect": "out"
    },
    {
      "label": "on_blend",
      "point": [
        "5 + r - r * cos(radians(45))",
        "4 + r - r * sin(radians(45))",
        5
      ],
      "expect": "on"
    },
    {
      "label": "plate_floor_in_the_footprint_corner",
      "point": [
        5.05,
        4.05,
        2
      ],
      "expect": "on"
    },
    {
      "label": "rib_top_corner_gone",
      "point": [
        5.02,
        4.02,
        8
      ],
      "expect": "out"
    },
    {
      "label": "far_vertex",
      "point": [
        0,
        0,
        0
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "volume": "20 * 10 * 2 + 10 * 2 * 6 - (1 - pi / 4) * r^2 * 6"
  }
}
