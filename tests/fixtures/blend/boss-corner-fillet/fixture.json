{
  "description": "a block [0,0,0]\u2013[20,10,2] with a boss [5,2,2]\u2013[11,8,6] standing on it, the boss's vertical corner edge at (5, 2) filleted at r 0.5: a convex blend whose lower end meets the plate's top at a concave corner, as a rib's does, on a boss that is square",
  "params": {
    "r": 0.5
  },
  "steps": [
    {
      "name": "plate",
      "op": "box",
      "min": [
        0,
        0,
        0
      ],
      "max": [
        20,
        10,
        2
      ]
    },
    {
      "name": "boss",
      "op": "box",
      "min": [
        5,
        2,
        2
      ],
      "max": [
        11,
        8,
        6
      ]
    },
    {
      "name": "bossed",
      "op": "fuse",
      "a": "plate",
      "b": "boss"
    },
    {
      "name": "result",
      "op": "fillet",
      "of": "bossed",
      "edges": [
        [
          5,
          2,
          4
        ]
      ],
      "radius": "r"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "inside_boss",
      "point": [
        8,
        5,
        4
      ],
      "expect": "in"
    },
    {
      "label": "removed_corner",
      "point": [
        5.02,
        2.02,
        4
      ],
      "expect": "out"
    },
    {
      "label": "on_blend",
      "point": [
        "5 + r - r / sqrt(2)",
        "2 + r - r / sqrt(2)",
        4
      ],
      "expect": "on"
    },
    {
      "label": "far_vertex",
      "point": [
        0,
        0,
        0
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "volume": "20 * 10 * 2 + 6 * 6 * 4 - (1 - pi / 4) * r^2 * 4"
  }
}
