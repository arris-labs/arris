{
  "description": "the stadium of blend/stadium-outline-fillet with its whole top outline chamfered at d 0.25 in one call: a flat strip along each side and half a cone over each half circle, the strips meeting the cones in the straight chord between the two contact points at each tangent vertex (ADR-0035). The removed corner's section d\u00b2 / 2 swept 2 + 2 along the sides and a full turn about the round ends' common radius 1 \u2212 d / 3 by Pappus",
  "params": {
    "d": 0.25
  },
  "steps": [
    {
      "name": "sketch",
      "op": "profile",
      "plane": {
        "origin": [
          0,
          0,
          0
        ],
        "x": [
          1,
          0,
          0
        ],
        "y": [
          0,
          1,
          0
        ]
      },
      "outer": {
        "start": [
          0,
          -1
        ],
        "segments": [
          {
            "line_to": [
              2,
              -1
            ]
          },
          {
            "arc_to": [
              2,
              1
            ],
            "via": [
              3,
              0
            ]
          },
          {
            "line_to": [
              0,
              1
            ]
          },
          {
            "arc_to": [
              0,
              -1
            ],
            "via": [
              -1,
              0
            ]
          }
        ]
      }
    },
    {
      "name": "stadium",
      "op": "extrude",
      "profile": "sketch",
      "direction": [
        0,
        0,
        1
      ],
      "length": 1
    },
    {
      "name": "result",
      "op": "chamfer",
      "of": "stadium",
      "edges": [
        [
          1,
          -1,
          1
        ],
        [
          3,
          0,
          1
        ],
        [
          1,
          1,
          1
        ],
        [
          -1,
          0,
          1
        ]
      ],
      "distance": "d"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "inside",
      "point": [
        1,
        0,
        0.5
      ],
      "expect": "in"
    },
    {
      "label": "corner_gone",
      "point": [
        1,
        "1 - d / 4",
        "1 - d / 4"
      ],
      "expect": "out"
    },
    {
      "label": "on_chamfer",
      "point": [
        1,
        "1 - d / 2",
        "1 - d / 2"
      ],
      "expect": "on"
    },
    {
      "label": "on_chamfer_round",
      "point": [
        "2 + 1 - d / 2",
        0,
        "1 - d / 2"
      ],
      "expect": "on"
    },
    {
      "label": "on_top_contact",
      "point": [
        1,
        "1 - d",
        1
      ],
      "expect": "on"
    },
    {
      "label": "on_side_contact",
      "point": [
        1,
        1,
        "1 - d"
      ],
      "expect": "on"
    },
    {
      "label": "on_bottom_rim",
      "point": [
        1,
        1,
        0
      ],
      "expect": "on"
    },
    {
      "label": "on_top",
      "point": [
        1,
        0,
        1
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "genus": 0,
    "volume": "4 + pi - 4 * d^2 / 2 - 2 * pi * (1 - d / 3) * d^2 / 2"
  }
}
