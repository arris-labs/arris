{
  "description": "blend/cylinder-rim-spindle-fillet with a cylinder of radius 0.3 fused across its spindle blend: the cylinder's axis is the line x = 1.5, z = 2.6 along y, off the blend's axis, and crosses the band face, the top plane and the wall. The result is an operand of a boolean, as the ring torus's faces are (ADR-0080)",
  "params": {"r": 1.5},
  "steps": [
    {
      "name": "section",
      "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 0, 1]},
      "outer": {"start": [0, 0], "segments": [{"line_to": [2, 0]}, {"line_to": [2, 3]}, {"line_to": [0, 3]}, {"line_to": [0, 0]}]}
    },
    {"name": "part", "op": "revolve", "profile": "section", "axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "angle_deg": 360},
    {"name": "blended", "op": "fillet", "of": "part", "edges": [[0, 2, 3]], "radius": "r"},
    {"name": "pin", "op": "cylinder", "base": [1.5, -3, 2.6], "axis": [0, 1, 0], "radius": 0.3, "height": 6},
    {"name": "result", "op": "fuse", "a": "blended", "b": "pin"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [0, 0, 1], "expect": "in"},
    {"label": "in the pin", "point": [1.5, 2.5, 2.6], "expect": "in"}
  ],
  "analytic": {
    "genus": 0
  }
}
