{
  "kind": "query",
  "description": "parts a consumer measures: a pin through a drilled plate's hole (coaxial, then off-centre by 1), a ball on a filleted block's blend and over its flat, a countersunk plate against a tilted slab (cone against a plane), a B-spline cylinder from STEP against a point, and the same pin and ball a long way from the origin",
  "analytic": {"query_differs": "Open CASCADE lists the sampled ends of a ring of equally near points (the pin coaxial in the hole) and one pair for a ball on a cylindrical blend; Arris returns one pair and says unique is false for the ring"},
  "tolerances": {"centroid_abs": 0.02},
  "steps": [
    {"name": "plate", "op": "box", "min": [0, 0, 0], "max": [100, 60, 10]},
    {"name": "hole", "op": "cylinder", "base": [50, 30, -1], "axis": [0, 0, 1], "radius": 8, "height": 12},
    {"name": "drilled", "op": "cut", "target": "plate", "tool": "hole"},
    {"name": "pin", "op": "cylinder", "base": [50, 30, -10], "axis": [0, 0, 1], "radius": 5, "height": 30},
    {"name": "pin_off", "op": "cylinder", "base": [51, 30, -10], "axis": [0, 0, 1], "radius": 5, "height": 30},
    {"name": "cube", "op": "box", "min": [0, 0, 0], "max": [20, 20, 20]},
    {"name": "block", "op": "fillet", "of": "cube", "edges": [[20, 20, 10]], "radius": 4},
    {"name": "on_blend", "op": "profile", "plane": {"origin": [23.071067811865476, 23.071067811865476, 10], "x": [1, 0, 0], "y": [0, 0, 1]},
     "outer": {"start": [0, -3], "segments": [{"arc_to": [0, 3], "via": [3, 0]}, {"line_to": [0, -3]}]}},
    {"name": "ball_blend", "op": "revolve", "profile": "on_blend", "axis": {"origin": [23.071067811865476, 23.071067811865476, 10], "direction": [0, 0, 1]}, "angle_deg": 360},
    {"name": "over_flat", "op": "profile", "plane": {"origin": [10, 10, 28], "x": [1, 0, 0], "y": [0, 0, 1]},
     "outer": {"start": [0, -3], "segments": [{"arc_to": [0, 3], "via": [3, 0]}, {"line_to": [0, -3]}]}},
    {"name": "ball_flat", "op": "revolve", "profile": "over_flat", "axis": {"origin": [10, 10, 28], "direction": [0, 0, 1]}, "angle_deg": 360},
    {"name": "plate2", "op": "box", "min": [0, 0, 0], "max": [60, 60, 10]},
    {"name": "sink_profile", "op": "profile", "plane": {"origin": [30, 30, 0], "x": [1, 0, 0], "y": [0, 0, 1]},
     "outer": {"start": [0, -1], "segments": [{"line_to": [3, -1]}, {"line_to": [3, 5]}, {"line_to": [9, 11]}, {"line_to": [0, 11]}, {"line_to": [0, -1]}]}},
    {"name": "sink", "op": "revolve", "profile": "sink_profile", "axis": {"origin": [30, 30, 0], "direction": [0, 0, 1]}, "angle_deg": 360},
    {"name": "countersunk", "op": "cut", "target": "plate2", "tool": "sink"},
    {"name": "slab", "op": "box", "min": [0, 0, -45], "max": [60, 60, -15]},
    {"name": "slab_t", "op": "transform", "of": "slab", "rotate": {"axis": [0, 1, 0], "origin": [30, 30, -15], "angle_deg": 20}},
    {"name": "wall", "op": "step", "file": "nurbs-cylinder.step", "sha256": "7a14cfcc3f0a6eb882ad08e4d6e1a547005b3ff9fd77c2cde0977176727815d1", "id": 15},
    {"name": "pin_far", "op": "transform", "of": "pin", "translate": [100000, -200000, 300000]},
    {"name": "drilled_far", "op": "transform", "of": "drilled", "translate": [100000, -200000, 300000]}
  ],
  "result": "drilled",
  "queries": [
    {"label": "pin coaxial in the hole",
     "distance": {"a": {"step": "drilled"}, "b": {"step": "pin"}}, "expect_distance": 3},
    {"label": "pin off-centre in the hole",
     "distance": {"a": {"step": "drilled"}, "b": {"step": "pin_off"}}, "expect_distance": 2},
    {"label": "pin off-centre against the hole wall alone",
     "distance": {"a": {"step": "drilled", "face": {"near": [58, 30, 5]}}, "b": {"step": "pin_off", "face": {"near": [56, 30, 0]}}}, "expect_distance": 2},
    {"label": "pin coaxial in the hole, a long way from the origin",
     "distance": {"a": {"step": "drilled_far"}, "b": {"step": "pin_far"}}, "expect_distance": 3},
    {"label": "ball on the blend",
     "distance": {"a": {"step": "block"}, "b": {"step": "ball_blend"}}, "expect_distance": 3},
    {"label": "ball on the blend, the blend face alone",
     "distance": {"a": {"step": "block", "face": {"near": [19, 19, 10]}}, "b": {"step": "ball_blend"}}, "expect_distance": 3},
    {"label": "ball over the flat top",
     "distance": {"a": {"step": "block"}, "b": {"step": "ball_flat"}}, "expect_distance": 5},
    {"label": "countersink cone against a tilted slab",
     "distance": {"a": {"step": "countersunk", "face": {"near": [35.5, 30, 7.5]}}, "b": {"step": "slab_t", "face": {"near": [30, 30, -15]}}}},
    {"label": "countersunk plate against a tilted slab",
     "distance": {"a": {"step": "countersunk"}, "b": {"step": "slab_t"}}},
    {"label": "a point beside the B-spline cylinder",
     "distance": {"a": {"point": [7, 3, 4]}, "b": {"step": "wall"}}, "expect_distance": 2.6157731058639087},
    {"label": "a point to the B-spline wall alone",
     "distance": {"a": {"point": [7, 3, 4]}, "b": {"step": "wall", "face": {"near": [5, 0, 5]}}}, "expect_distance": 2.6157731058639087},
    {"label": "a point above the B-spline cap",
     "distance": {"a": {"point": [1, 2, 14]}, "b": {"step": "wall"}}, "expect_distance": 4},
    {"label": "a point inside the B-spline cylinder",
     "distance": {"a": {"point": [1, 1, 4]}, "b": {"step": "wall"}}, "expect_distance": 0}
  ]
}
