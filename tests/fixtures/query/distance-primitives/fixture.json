    {"name": "pipe_r", "op": "transform", "of": "pipe", "rotate": {"axis": [1, 2, 3], "angle_deg": 37}},
    {"name": "rod_x", "op": "cylinder", "base": [0, 0, 0], "axis": [1, 0, 0], "radius": 3, "height": 40},
    {"name": "rod_y", "op": "cylinder", "base": [20, -20, 10], "axis": [0, 1, 0], "radius": 2, "height": 40},
    {"name": "rod_x_r", "op": "transform", "of": "rod_x", "rotate": {"axis": [1, 2, 3], "angle_deg": 37}},
    {"name": "rod_y_r", "op": "transform", "of": "rod_y", "rotate": {"axis": [1, 2, 3], "angle_deg": 37}},
    {"name": "trapezoid", "op": "profile", "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 0, 1]},
     "outer": {"start": [0, -2], "segments": [{"line_to": [4, -2]}, {"line_to": [2, 2]}, {"line_to": [0, 2]}, {"line_to": [0, -2]}]}},
    {"name": "frustum", "op": "revolve", "profile": "trapezoid", "axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "angle_deg": 360},
