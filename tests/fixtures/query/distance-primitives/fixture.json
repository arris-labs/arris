    {"name": "torus_t", "op": "transform", "of": "torus", "rotate": {"axis": [0, 1, 0], "origin": [25, 0, 0], "angle_deg": 40}},
    {"name": "slab", "op": "box", "min": [-20, -20, -30], "max": [60, 20, -8]},
    {"name": "slab_t", "op": "transform", "of": "slab", "rotate": {"axis": [1, 0, 0], "origin": [0, 0, -8], "angle_deg": 15}}
