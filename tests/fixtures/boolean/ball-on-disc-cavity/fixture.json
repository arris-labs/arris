{
  "description": "A ball cut from a box would have its south pole tangent to the outer bottom face. Refuse the point contact within one lump.",
  "steps": [
    {"name": "section", "op": "profile", "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 0, 1]}, "outer": {"start": [0, -2], "segments": [{"arc_to": [0, 2], "via": [2, 0]}, {"line_to": [0, -2]}]}},
    {"name": "ball", "op": "revolve", "profile": "section", "axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "angle_deg": 360},
    {"name": "box", "op": "box", "min": [-3, -3, -2], "max": [3, 3, 3]},
    {"name": "result", "op": "cut", "target": "box", "tool": "ball"}
  ],
  "result": "result",
  "probes": [
    {"label": "in_wall", "point": [2.5, 0, 0], "expect": "in"},
    {"label": "in_cavity", "point": [0, 0, 0], "expect": "out"},
    {"label": "contact", "point": [0, 0, -2], "expect": "on"}
  ],
  "analytic": {"expect_error": "tangent-contact", "volume": "180 - 32 * pi / 3", "area": "192 + 16 * pi"}
}
