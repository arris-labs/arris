{
  "description": "A 0.01 gap between the ball pole and the offset end disc leaves two separate lumps.",
  "params": {"offset": 0.3, "shift": -0.01},
  "steps": [
    {"name": "section", "op": "profile", "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 0, 1]}, "outer": {"start": [0, -2], "segments": [{"arc_to": [0, 2], "via": [2, 0]}, {"line_to": [0, -2]}]}},
    {"name": "ball", "op": "revolve", "profile": "section", "axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "angle_deg": 360},
    {"name": "stem", "op": "cylinder", "base": ["offset", 0, "-5 + shift"], "axis": [0, 0, 1], "radius": 1, "height": 3},
    {"name": "result", "op": "fuse", "a": "stem", "b": "ball"}
  ],
  "result": "result",
  "probes": [
    {"label": "inside_ball", "point": [0, 0, 0], "expect": "in"},
    {"label": "inside_stem", "point": ["offset", 0, "-3 + shift"], "expect": "in"},
    {"label": "gap", "point": [0, 0, -2.005], "expect": "out"}
  ],
  "analytic": {"volume": "41 * pi / 3", "area": "24 * pi", "centroid": ["9 * offset / 41", 0, "9 * (-3.5 + shift) / 41"], "genus": 0, "occt_step_refused": {"kind": "unsupported entity", "why": "Open CASCADE writes the whole sphere as a face of one VERTEX_LOOP with no seam; the reader maps a VERTEX_LOOP only beside one EDGE_LOOP (docs/BACKLOG.md)."}}
}
