    {"label": "outside", "point": [1.5, 0, -2], "expect": "out"}
  ],
  "analytic": {"volume": "41 * pi / 3", "area": "24 * pi", "centroid": ["9 * offset / 41", 0, "-31.5 / 41"], "counts": {"vertices": 4, "edges": 4, "faces": 4, "loops": 4, "shells": 2, "solids": 2}, "genus": 0, "occt_step_refused": {"kind": "unsupported entity", "why": "Open CASCADE writes the whole sphere as a face of one VERTEX_LOOP with no seam; the reader maps a VERTEX_LOOP only beside one EDGE_LOOP (docs/BACKLOG.md)."}}
