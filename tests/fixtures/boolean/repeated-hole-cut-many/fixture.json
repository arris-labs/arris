        0,
        0
      ],
      "max": [
        100,
        100,
        "t"
      ]
    },
    {
      "name": "h1",
      "op": "cylinder",
      "base": [
        50,
        50,
        -1
      ],
      "axis": [
        0,
        0,
        1
      ],
      "radius": "r",
      "height": 12
    },
    {
      "name": "h2",
      "op": "cylinder",
      "base": [
        50,
        50,
        -1
      ],
      "axis": [
        0,
        0,
        1
      ],
      "radius": "r",
      "height": 12
    },
    {
      "name": "result",
      "op": "cut",
      "target": "plate",
      "tools": [
        "h1",
        "h2"
      ]
