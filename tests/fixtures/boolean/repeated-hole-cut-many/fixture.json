    {
      "label": "on_top",
      "point": [
        5,
        5,
        "t"
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "volume": "100 * 100 * t - pi * r^2 * t",
    "area": "2 * 100 * 100 + 4 * 100 * t - 2 * pi * r^2 + 2 * pi * r * t",
