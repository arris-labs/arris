{
  "description": "A box bridge joins the touching ball and stem. It leaves the contact at the ball pole exposed. Arris refuses TangentContact naming the ball and disc faces.",
  "steps": [
    {
      "name": "section",
      "op": "profile",
      "plane": {
        "origin": [
          0,
          0,
          0
        ],
        "x": [
          1,
          0,
          0
        ],
        "y": [
          0,
          0,
          1
        ]
      },
      "outer": {
        "start": [
          0,
          -2
        ],
        "segments": [
          {
            "arc_to": [
              0,
              2
            ],
            "via": [
              2,
              0
            ]
          },
          {
            "line_to": [
              0,
              -2
            ]
          }
        ]
      }
    },
    {
      "name": "ball",
      "op": "revolve",
      "profile": "section",
      "axis": {
        "origin": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          1
        ]
      },
      "angle_deg": 360
    },
    {
      "name": "stem",
      "op": "cylinder",
      "base": [
        0,
        0,
        -5
      ],
      "axis": [
        0,
        0,
        1
      ],
      "radius": 1,
      "height": 3
    },
    {
      "name": "touching",
      "op": "fuse",
      "a": "stem",
      "b": "ball"
    },
    {
      "name": "bridge",
      "op": "box",
      "min": [
        0.5,
        -0.25,
        -2.25
      ],
      "max": [
        0.8,
        0.25,
        -1.5
      ]
    },
    {
      "name": "result",
      "op": "fuse",
      "a": "touching",
      "b": "bridge"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "contact",
      "point": [
        0,
        0,
        -2
      ],
      "expect": "on"
    },
    {
      "label": "bridge",
      "point": [
        0.65,
        0,
        -1.99
      ],
      "expect": "in"
    },
    {
      "label": "outside",
      "point": [
        1.5,
        0,
        -2
      ],
      "expect": "out"
    }
  ],
  "analytic": {
    "expect_error": "tangent-contact"
  }
}
