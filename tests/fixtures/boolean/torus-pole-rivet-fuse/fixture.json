{
  "description": "The rivet's spindle-torus head and a coaxial cylindrical shank share a disk on the head's flat side. The shank adds its own volume and first moment, and its outer wall adds area. Its free cap replaces the disk hidden at the join.",
  "steps": [
    {
      "name": "meridian", "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 1, 0]},
      "outer": {"start": [0, 4], "segments": [
        {"via": [6, 4], "arc_to": [8, 0]}, {"line_to": [0, 0]}, {"line_to": [0, 4]}
      ]}
    },
    {"name": "apple", "op": "revolve", "profile": "meridian", "axis": {"origin": [0, 0, 0], "direction": [0, 1, 0]}, "angle_deg": 360},
    {"name": "shank", "op": "cylinder", "base": [0, 0, 0], "axis": [0, -1, 0], "radius": 2, "height": 6},
    {"name": "result", "op": "fuse", "a": "apple", "b": "shank"}
  ],
  "result": "result",
  "probes": [
    {"label": "shank", "point": [0, -3, 0], "expect": "in"},
    {"label": "join", "point": [0, 0, 0], "expect": "in"},
    {"label": "head", "point": [3, 4.5, 0], "expect": "in"},
    {"label": "pole", "point": [0, 4, 0], "expect": "on"},
    {"label": "under_head", "point": [3, 0, 0], "expect": "on"},
    {"label": "beside_shank", "point": [3, -1, 0], "expect": "out"}
  ],
  "analytic": {
    "volume": "pi * (308 + 225 * (pi - atan(4 / 3))) / 3",
    "area": "10 * pi * (3 * (pi - atan(4 / 3)) + 4) + 88 * pi",
    "centroid": [0, "1320 / (308 + 225 * (pi - atan(4 / 3)))", 0],
    "genus": 0
  }
}
