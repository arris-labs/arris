{
  "description": "the frustum of sweep/revolve-frustum: a cone face, a bore and two annuli, mirrored in a plane: `default` beside it (x = c + size + 5), `through` its centre across x, `across` a plane cut obliquely through it, off centre. The image has the original's volume, area, counts and genus, its centroid reflected (ADR-0031)",
  "params": {
    "lo": 4,
    "hi": 2,
    "angle": 360,
    "caps": 0,
    "ox": 9,
    "oy": 0,
    "oz": 0,
    "nx": 1,
    "ny": 0,
    "nz": 0
  },
  "variants": {
    "through": {
      "ox": 0,
      "oy": 0,
      "oz": 0,
      "nx": 1,
      "ny": 0,
      "nz": 0
    },
    "across": {
      "ox": 1.2,
      "oy": 0,
      "oz": 0,
      "nx": 1,
      "ny": 2,
      "nz": -0.5
    }
  },
  "steps": [
    {
      "name": "trapezoid",
      "op": "profile",
      "plane": {
        "origin": [
          0,
          0,
          0
        ],
        "x": [
          1,
          0,
          0
        ],
        "y": [
          0,
          0,
          1
        ]
      },
      "outer": {
        "start": [
          1,
          -1
        ],
        "segments": [
          {
            "line_to": [
              "lo",
              -1
            ]
          },
          {
            "line_to": [
              "hi",
              1
            ]
          },
          {
            "line_to": [
              1,
              1
            ]
          },
          {
            "line_to": [
              1,
              -1
            ]
          }
        ]
      }
    },
    {
      "name": "body",
      "op": "revolve",
      "profile": "trapezoid",
      "axis": {
        "origin": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          1
        ]
      },
      "angle_deg": "angle"
    },
    {
      "name": "result",
      "op": "mirror",
      "of": "body",
      "plane": {
        "origin": [
          "ox",
          "oy",
          "oz"
        ],
        "normal": [
          "nx",
          "ny",
          "nz"
        ]
      }
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "image_of_the_centre",
      "point": [
        "0 - 2 * ((0-ox)*nx+(0-oy)*ny+(0-oz)*nz)/(nx^2+ny^2+nz^2) * nx",
        "0 - 2 * ((0-ox)*nx+(0-oy)*ny+(0-oz)*nz)/(nx^2+ny^2+nz^2) * ny",
        "0 - 2 * ((0-ox)*nx+(0-oy)*ny+(0-oz)*nz)/(nx^2+ny^2+nz^2) * nz"
      ],
      "expect": null
    },
    {
      "label": "at_the_centre",
      "point": [
        0,
        0,
        0
      ],
      "expect": null
    },
    {
      "label": "far",
      "point": [
        40,
        40,
        40
      ],
      "expect": "out"
    }
  ],
  "analytic": {
    "volume": "(2 * pi * (16 + 8 + 4) / 3 - 2 * pi) * angle / 360",
    "area": "(15 * pi + 3 * pi + 6 * sqrt(8) * pi + 4 * pi) * angle / 360 + caps"
  }
}
