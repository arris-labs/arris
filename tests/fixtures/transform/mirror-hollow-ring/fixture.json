{
  "description": "the moved hollow ring of transform/moved-hollow-ring, a body of two shells, mirrored in a plane: `default` beside it (x = c + size + 5), `through` its centre across x, `across` a plane cut obliquely through it, off centre. The image has the original's volume, area, counts and genus, its centroid reflected (ADR-0031)",
  "params": {
    "ox": 20,
    "oy": -5,
    "oz": 3,
    "nx": 1,
    "ny": 0,
    "nz": 0
  },
  "variants": {
    "through": {
      "ox": 10,
      "oy": -5,
      "oz": 3,
      "nx": 1,
      "ny": 0,
      "nz": 0
    },
    "across": {
      "ox": 11.5,
      "oy": -5,
      "oz": 3,
      "nx": 1,
      "ny": 2,
      "nz": -0.5
    }
  },
  "steps": [
    {
      "name": "section",
      "op": "profile",
      "plane": {
        "origin": [
          0,
          0,
          0
        ],
        "x": [
          1,
          0,
          0
        ],
        "y": [
          0,
          0,
          1
        ]
      },
      "outer": {
        "start": [
          1,
          -2
        ],
        "segments": [
          {
            "line_to": [
              4,
              -2
            ]
          },
          {
            "line_to": [
              4,
              2
            ]
          },
          {
            "line_to": [
              1,
              2
            ]
          },
          {
            "line_to": [
              1,
              -2
            ]
          }
        ]
      },
      "holes": [
        {
          "start": [
            2,
            -1
          ],
          "segments": [
            {
              "line_to": [
                3,
                -1
              ]
            },
            {
              "line_to": [
                3,
                1
              ]
            },
            {
              "line_to": [
                2,
                1
              ]
            },
            {
              "line_to": [
                2,
                -1
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "ring",
      "op": "revolve",
      "profile": "section",
      "axis": {
        "origin": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          0,
          1
        ]
