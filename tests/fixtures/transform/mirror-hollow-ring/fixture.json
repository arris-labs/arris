    {
      "name": "body",
      "op": "transform",
      "of": "ring",
      "rotate": {
        "axis": [
          1,
          0,
          0
        ],
        "origin": [
          0,
          0,
          0
        ],
        "angle_deg": 30
      },
      "translate": [
        10,
        -5,
        3
      ]
    },
    {
      "name": "result",
      "op": "mirror",
      "of": "body",
      "plane": {
        "origin": [
          "ox",
          "oy",
          "oz"
        ],
        "normal": [
          "nx",
          "ny",
          "nz"
        ]
      }
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "image_of_the_centre",
      "point": [
        "10 - 2 * ((10-ox)*nx+(-5-oy)*ny+(3-oz)*nz)/(nx^2+ny^2+nz^2) * nx",
        "-5 - 2 * ((10-ox)*nx+(-5-oy)*ny+(3-oz)*nz)/(nx^2+ny^2+nz^2) * ny",
        "3 - 2 * ((10-ox)*nx+(-5-oy)*ny+(3-oz)*nz)/(nx^2+ny^2+nz^2) * nz"
      ],
      "expect": null
    },
    {
      "label": "at_the_centre",
