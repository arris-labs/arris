  "analytic": {
    "volume": "pi * (16 - 1) * 4 - pi * (9 - 4) * 2",
    "area": "2 * pi * (16 - 1) + 2 * pi * (4 + 1) * 4 + 2 * pi * (9 - 4) + 2 * pi * (3 + 2) * 2",
    "counts": {
      "vertices": 8,
      "edges": 12,
