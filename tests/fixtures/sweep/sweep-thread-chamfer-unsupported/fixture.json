{
  "description": "the triangular thread of sweep/sweep-thread (fitted NURBS faces) with its outer crest rail chamfered at distance 0.1: an edge between two NURBS surfaces, which Arris refuses as Unsupported naming both faces, while Open CASCADE builds it (plans/sweep step 7)",
  "tolerances": {"probe": 1e-3},
  "params": {"R": 10, "p": 4, "turns": 3, "d": 0.1},
  "steps": [
    {
      "name": "sketch",
      "op": "profile",
      "plane": {"origin": ["R", 0, 0], "x": [1, 0, 0], "y": [0, 0, 1]},
      "outer": {
        "start": [0, -1.2],
        "segments": [
          {"line_to": [1.5, 0]},
          {"line_to": [0, 1.2]},
          {"line_to": [0, -1.2]}
        ]
      },
      "holes": []
    },
    {
      "name": "thread",
      "op": "sweep",
      "profile": "sketch",
      "path": {
        "start": ["R", 0, 0],
        "segments": [{"helix": {"axis": {"origin": [0, 0, 0], "direction": [0, 0, 1]}, "pitch": "p", "angle_deg": "360 * turns"}}]
      },
      "law": {"binormal": [0, 0, 1]}
    },
    {
      "name": "result",
      "op": "chamfer",
      "of": "thread",
      "edges": [
        [0, 11.5, 1.0]
      ],
      "distance": "d"
    }
  ],
  "result": "result",
  "probes": [
    {"label": "tooth_root", "point": [0, "R + 0.5", "p / 4"], "expect": "in"},
    {"label": "outside_apex", "point": [0, "R + 2", "p / 4"], "expect": "out"}
  ],
  "analytic": {
    "expect_error": "unsupported",
    "genus": 0
  }
}
