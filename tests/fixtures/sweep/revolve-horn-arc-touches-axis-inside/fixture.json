{
  "description": "The left half of a unit disk centred 1 from the y axis, turned 180 degrees. The second segment has endpoints (1, 1) and (1, -1) but touches the axis at its interior point (0, 0). The desired refusal names loop 0, segment 1. Open CASCADE's body has half-annular sections with radii 1 and 1 - sqrt(1 - y^2); integrate their areas for volume. The torus band contributes pi*(pi - 2), the outer cylinder 2*pi and the two end caps pi.",
  "steps": [
    {
      "name": "meridian", "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, 1, 0]},
      "outer": {"start": [1, -1], "segments": [
        {"line_to": [1, 1]}, {"via": [0, 0], "arc_to": [1, -1]}
      ]}
    },
    {"name": "result", "op": "revolve", "profile": "meridian", "axis": {"origin": [0, 0, 0], "direction": [0, 1, 0]}, "angle_deg": 180}
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [0, 0, -0.5], "expect": "in"},
    {"label": "inside_bore", "point": [0, 0.8, -0.2], "expect": "out"},
    {"label": "behind_caps", "point": [0, 0, 0.5], "expect": "out"},
    {"label": "on_pole", "point": [0, 0, 0], "expect": "on"},
    {"label": "on_cylinder", "point": [0, 0, -1], "expect": "on"},
    {"label": "on_cap", "point": [0.5, 0, 0], "expect": "on"}
  ],
  "analytic": {
    "expect_error": {"arc-touches-axis": {"loop_index": 0, "segment": 1}},
    "volume": "pi * (pi - 4 / 3) / 2",
    "area": "pi ^ 2 + pi",
    "centroid": [0, 0, "-(2 / pi) * (5 * pi / 8 - 4 / 3) / ((pi - 4 / 3) / 2)"],
    "genus": 0
  }
}
