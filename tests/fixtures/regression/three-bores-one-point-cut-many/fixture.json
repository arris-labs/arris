  "analytic": {
    "volume": "L ^ 3 - (3 * pi * r * r * L - 16 * r ^ 3 + 8 * (2 - sqrt(2)) * r ^ 3)",
    "area": "6 * L * L - 6 * pi * r * r + 3 * (2 * pi * r * L - 16 * r * r + 8 * (2 - sqrt(2)) * r * r)",
    "centroid": [
      20,
      20,
      20
    ],
