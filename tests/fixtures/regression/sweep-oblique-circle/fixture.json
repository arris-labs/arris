{
  "description": "a circle of radius 3 in a plane tilted 30 degrees off the path's normal, carried 12 along a line: the exact elliptic cylinder, volume pi * 3^2 * cos(30 degrees) * 12 (the projected area times the length; ADR-0063)",
  "params": {"r": 3, "L": 12, "t": 30},
  "steps": [
    {
      "name": "sketch",
      "op": "profile",
      "plane": {"origin": [0, 0, 0], "x": [1, 0, 0], "y": [0, "cos(radians(t))", "sin(radians(t))"]},
      "outer": {"circle": {"center": [0, 0], "radius": "r"}},
      "holes": []
    },
    {
      "name": "result",
      "op": "sweep",
      "profile": "sketch",
      "path": {"start": [0, 0, 0], "segments": [{"line_to": [0, 0, "L"]}]},
      "law": "rotation_minimizing"
    }
  ],
  "result": "result",
  "probes": [
    {"label": "inside", "point": [0, 0, 6], "expect": "in"},
    {"label": "outside", "point": [0, 5, 6], "expect": "out"},
    {"label": "on_side", "point": [0, "r * cos(radians(t))", 6], "expect": "on"},
    {"label": "on_start_cap", "point": [0, 0, 0], "expect": "on"}
  ],
  "analytic": {
    "volume": "pi * r^2 * cos(radians(t)) * L",
    "genus": 0
  }
}
