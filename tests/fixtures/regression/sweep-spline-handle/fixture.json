          {"arc_to": [-2, -1], "via": [-3, 0]}
        ]
      },
      "holes": []
    },
    {
      "name": "result",
      "op": "sweep",
      "profile": "sketch",
      "path": {
        "start": [0, 0, 0],
        "segments": [{"nurbs": {
          "degree": 3,
          "knots": [0, 0, 0, 0, 1, 1, 1, 1],
          "control_points": [[0, 0, 0], [0, 0, 15], [15, 0, 25], [30, 0, 25]],
          "weights": [1, 1, 1, 1]
        }}]
      },
      "law": "rotation_minimizing"
