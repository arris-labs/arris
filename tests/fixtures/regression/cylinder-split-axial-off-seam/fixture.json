{
  "description": "a cylinder of radius r and height 10 on the z axis split by a plane containing the axis, off its seam (the plane's normal is (-1, 1, 0): the seam is an eighth of a turn from the plane's trace): a half-cylinder on either side, the cap a 2r by 10 rectangle",
  "params": {
    "r": 3,
    "side": 1
  },
  "variants": {
    "negative": {
      "side": -1
    }
  },
  "steps": [
    {
      "name": "cyl",
      "op": "cylinder",
      "base": [
        0,
        0,
        0
      ],
      "axis": [
        0,
        0,
        1
      ],
      "radius": "r",
      "height": 10
    },
    {
      "name": "result",
      "op": "split",
      "of": "cyl",
      "plane": {
        "origin": [
          0,
          0,
          0
        ],
        "normal": [
          -1,
          1,
          0
        ]
      },
      "side": "side"
    }
  ],
  "result": "result",
  "probes": [
    {
      "label": "on_cap",
      "point": [
        0,
        0,
        5
      ],
      "expect": "on"
    },
    {
      "label": "pos",
      "point": [
        "r / 2 * (-1 / sqrt(2))",
        "r / 2 * (1 / sqrt(2))",
        5
      ]
    },
    {
      "label": "neg",
      "point": [
        "-r / 2 * (-1 / sqrt(2))",
        "-r / 2 * (1 / sqrt(2))",
        5
      ]
    },
    {
      "label": "on_wall_edge",
      "point": [
        "r * (1 / sqrt(2))",
        "r * (1 / sqrt(2))",
        5
      ],
      "expect": "on"
    }
  ],
  "analytic": {
    "volume": "(1 + side) / 2 * (pi * r^2 * 10 / 2) + (1 - side) / 2 * (pi * r^2 * 10 / 2)",
    "area": "(1 + side) / 2 * (pi * r * 10 + pi * r^2 + 2 * r * 10) + (1 - side) / 2 * (pi * r * 10 + pi * r^2 + 2 * r * 10)",
    "centroid": [
      "(1 + side) / 2 * (4 * r / (3 * pi) * (-1 / sqrt(2))) + (1 - side) / 2 * (-4 * r / (3 * pi) * (-1 / sqrt(2)))",
      "(1 + side) / 2 * (4 * r / (3 * pi) * (1 / sqrt(2))) + (1 - side) / 2 * (-4 * r / (3 * pi) * (1 / sqrt(2)))",
      5
    ]
  }
}
